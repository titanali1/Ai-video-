# Copy to .env on the machine running server.py. Never commit the real .env.
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# Replace with a long random secret before exposing the API beyond your machine.
DEISA_API_KEY=replace-with-a-long-random-secret
# Set to the app's origin if you want to restrict cross-origin browser requests.
# Keep the API key enabled if using *.
DEISA_CORS_ORIGIN=*

# Optional Hugging Face Inference Providers (cloud credits are limited).
# Create a fine-grained token with Inference Providers permission.
HF_TOKEN=
HF_PROVIDER=hf-inference
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_TIMEOUT_SECONDS=900

# Optional self-hosted ComfyUI; API requests are not quota-metered,
# but generation consumes your own compatible GPU, memory, and electricity.
# Keep ComfyUI private; expose only this Deisa gateway over HTTPS.
COMFY_URL=http://127.0.0.1:8188
COMFY_API_KEY=
COMFY_TIMEOUT_SECONDS=1800
# Export each graph from ComfyUI in API format and store it under ./workflows/.
COMFY_IMAGE_WORKFLOW=workflows/image-api.json
COMFY_IMAGE_PROMPT_NODE=
COMFY_IMAGE_PROMPT_INPUT=text
COMFY_IMAGE_SEED_NODE=
COMFY_IMAGE_SEED_INPUT=seed
COMFY_IMAGE_OUTPUT_NODE=
COMFY_IMAGE_NODE=
COMFY_IMAGE_INPUT=image

COMFY_VIDEO_WORKFLOW=workflows/video-api.json
COMFY_VIDEO_PROMPT_NODE=
COMFY_VIDEO_PROMPT_INPUT=text
COMFY_VIDEO_SEED_NODE=
COMFY_VIDEO_SEED_INPUT=seed
COMFY_VIDEO_OUTPUT_NODE=
COMFY_VIDEO_IMAGE_NODE=
COMFY_VIDEO_IMAGE_INPUT=image
